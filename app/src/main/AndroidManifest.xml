<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets us tell saved contacts apart from unknown numbers. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Heads-up "Block / Spam" notification for unknown incoming calls. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the Block / Spam notification buttons hang up the ringing call. -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Optional: import older calls into the in-app history (personal use). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <application
        android:name=".SpamApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpamBlocker">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SpamScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.CallLabelListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.ActionReceiver"
            android:exported="false" />
    </application>
</manifest>
